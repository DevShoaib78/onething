{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onething",
  "compatibility_date": "2026-09-26",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
